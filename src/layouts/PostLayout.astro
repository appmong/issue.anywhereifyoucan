---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import MetaLine from "../components/MetaLine.astro";
import StatusBadge from "../components/StatusBadge.astro";
import DeadlineWidget from "../components/DeadlineWidget.astro";
import TldrCard from "../components/TldrCard.astro";
import Toc from "../components/Toc.astro";
import VerifyNote from "../components/VerifyNote.astro";
import AuthorBox from "../components/AuthorBox.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import SubscribeBox from "../components/SubscribeBox.astro";
import { AUTHORS, CATEGORY_MAP, DISCLAIMERS, SITE } from "../site.config";
import { categoryUrl, postUrl, isoDate } from "../lib/utils";

interface RelatedItem {
  id: string;
  category: string;
  title: string;
}
interface Heading {
  text: string;
  slug: string;
}

interface Props {
  id: string;
  data: {
    title: string;
    description: string;
    category: string;
    author: string;
    publishDate: Date;
    updatedDate?: Date;
    sourceCheckedDate?: Date;
    status: "상시" | "진행중" | "마감임박" | "마감";
    deadline?: Date;
    readingMinutes?: number;
    tldr: { q: string; a: string }[];
    sources: { title: string; org: string; url: string }[];
    thumb?: string;
    disclaimer: string;
    tags: string[];
  };
  headings: Heading[];
  related: RelatedItem[];
  ogImage?: string;
}

const { id, data, headings, related, ogImage } = Astro.props;
const cat = CATEGORY_MAP[data.category];
const author = AUTHORS[data.author] ?? Object.values(AUTHORS)[0];
const disclaimerText = DISCLAIMERS[data.disclaimer] ?? DISCLAIMERS.default;

// Article JSON-LD
const jsonld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  datePublished: isoDate(data.publishDate),
  dateModified: isoDate(data.updatedDate ?? data.publishDate),
  author: { "@type": "Person", name: author.name },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: new URL(postUrl(data.category, id), SITE.url).href,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  canonicalPath={postUrl(data.category, id)}
>
  <ReadingProgress />
  <article class="container">
    <Breadcrumb items={[{ name: cat?.name ?? data.category, href: categoryUrl(data.category) }, { name: data.title }]} />

    <header class="post-head">
      <div class="cat-row">
        <a href={categoryUrl(data.category)} class="cat">{cat?.name ?? data.category}</a>
        <StatusBadge status={data.status} />
      </div>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <MetaLine
        author={author}
        publishDate={data.publishDate}
        updatedDate={data.updatedDate}
        sourceCheckedDate={data.sourceCheckedDate}
        sourceCount={data.sources.length}
        readingMinutes={data.readingMinutes}
      />
    </header>

    <DeadlineWidget status={data.status} deadline={data.deadline} />

    <TldrCard items={data.tldr} />

    {data.thumb && (
      <figure class="hero">
        <img
          src={`/shots/${data.thumb}/thumb-wide.webp`}
          alt={data.title}
          width="1200"
          height="675"
          fetchpriority="high"
        />
      </figure>
    )}

    <Toc headings={headings} />

    <div class="prose">
      <slot />
    </div>

    <p class="disclaimer">{disclaimerText}</p>

    <VerifyNote sources={data.sources} checkedDate={data.sourceCheckedDate} />

    <AuthorBox author={author} />

    <SubscribeBox />

    <RelatedPosts items={related} />
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
</BaseLayout>

<style>
  .post-head { margin: 8px 0 4px; }
  .cat-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .cat-row .cat { font-size: 13.5px; font-weight: 700; color: var(--accent-ink); }
  h1 { font-size: 30px; line-height: 1.3; letter-spacing: -0.02em; margin: 6px 0; }
  .lead { font-size: 18px; color: var(--text-soft); margin: 10px 0 0; }
  .hero { margin: 22px 0; }
  .hero img { width: 100%; border-radius: var(--radius); border: 1px solid var(--border); }
  .disclaimer {
    margin: 28px 0; padding: 14px 16px; font-size: 13.5px; color: var(--text-mute);
    background: var(--bg-soft); border-radius: var(--radius-sm); border: 1px solid var(--border);
  }
  @media (max-width: 480px) {
    h1 { font-size: 25px; }
    .lead { font-size: 16px; }
  }
</style>
