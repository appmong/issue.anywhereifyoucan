---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import StatusBadge from "../components/StatusBadge.astro";
import FortuneNote from "../components/FortuneNote.astro";
import SubscribeBox from "../components/SubscribeBox.astro";
import { SITE, CATEGORIES, CATEGORY_MAP } from "../site.config";
import { categoryUrl, postUrl, fmtDate } from "../lib/utils";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featured = posts[0];
const featCat = featured ? CATEGORY_MAP[featured.data.category] : undefined;

// 인기 검색어 칩: 글 태그에서 자동 추출(콘텐츠에 맞춰 채워짐)
const chips = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].slice(0, 6);

// 사이트 구조화 데이터 (Organization + WebSite)
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#org`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/logo.png`,
      email: SITE.email,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      inLanguage: "ko-KR",
      publisher: { "@id": `${SITE.url}/#org` },
    },
  ],
};
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>{SITE.tagline}</h1>
      <p class="sub">{SITE.description}</p>

      <button class="hero-search" data-search-open type="button" aria-label="검색 열기">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M20 20 L16 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span class="hs-ph">무엇을 찾으세요? <b>제목·키워드로 검색</b></span>
        <kbd class="hs-kbd">/</kbd>
      </button>

      {chips.length > 0 && (
        <div class="hero-chips">
          <span class="hc-label">인기</span>
          {chips.map((t) => (
            <button class="chip" data-search-open data-search-q={t} type="button">{t}</button>
          ))}
        </div>
      )}
    </div>
  </section>

  <div class="container">
    <FortuneNote />
  </div>

  <div class="container-wide">
    {featured && (
      <section class="featured-wrap">
        <h2 class="sec-title">가장 최근 글</h2>
        <a class="featured card" href={postUrl(featured.data.category, featured.id)}>
          <div class="f-thumb">
            {featured.data.thumb ? (
              <img
                src={`/shots/${featured.data.thumb}/thumb-wide.webp`}
                alt=""
                width="720"
                height="405"
                loading="eager"
              />
            ) : (
              <span class="f-emoji">{featCat?.emoji ?? "📄"}</span>
            )}
          </div>
          <div class="f-body">
            <div class="f-top">
              <span class="cat">{featCat?.name ?? featured.data.category}</span>
              <StatusBadge status={featured.data.status} />
            </div>
            <h3>{featured.data.title}</h3>
            <p class="f-desc">{featured.data.description}</p>
            <time class="date">{fmtDate(featured.data.publishDate)}</time>
          </div>
        </a>
      </section>
    )}

    {CATEGORIES.map((c) => {
      const catPosts = posts
        .filter((p) => p.data.category === c.slug && p.id !== featured?.id)
        .slice(0, 3);
      if (catPosts.length === 0) return null;
      return (
        <section class="cat-section">
          <div class="cat-head">
            <h2 class="sec-title"><span class="ce" aria-hidden="true">{c.emoji}</span> {c.name}</h2>
            <a class="more" href={categoryUrl(c.slug)}>더보기 →</a>
          </div>
          <div class="grid">
            {catPosts.map((p) => (
              <PostCard
                id={p.id}
                category={p.data.category}
                title={p.data.title}
                description={p.data.description}
                publishDate={p.data.publishDate}
                status={p.data.status}
                thumb={p.data.thumb}
              />
            ))}
          </div>
        </section>
      );
    })}

    <SubscribeBox />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
</BaseLayout>

<style>
  .hero { padding: 48px 0 12px; text-align: center; }
  .hero h1 { font-size: 34px; letter-spacing: -0.03em; margin: 0 0 12px; line-height: 1.3; }
  .hero .sub { color: var(--text-soft); font-size: 17px; max-width: 560px; margin: 0 auto; }

  .hero-search {
    display: flex; align-items: center; gap: 11px;
    width: 100%; max-width: 540px; margin: 26px auto 0;
    padding: 15px 16px; border-radius: 14px;
    border: 1px solid var(--border-strong); background: var(--bg-card);
    box-shadow: var(--shadow); cursor: pointer; color: var(--text-mute);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .hero-search:hover { border-color: var(--accent); }
  .hs-ph { flex: 1; text-align: left; font-size: 15.5px; }
  .hs-ph b { color: var(--text-soft); font-weight: 600; }
  .hs-kbd {
    border: 1px solid var(--border); border-radius: 6px; padding: 1px 8px;
    font-size: 12.5px; font-family: inherit; color: var(--text-mute); background: var(--bg-soft);
  }
  .hero-chips {
    display: flex; flex-wrap: wrap; gap: 8px;
    justify-content: center; align-items: center; margin-top: 14px;
  }
  .hc-label { font-size: 13px; color: var(--text-mute); font-weight: 700; }
  .chip {
    border: 1px solid var(--border); background: var(--bg-soft); color: var(--text-soft);
    font-size: 13.5px; padding: 6px 12px; border-radius: 999px; cursor: pointer; font-family: inherit;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  @media (max-width: 480px) { .hs-ph b { display: none; } }

  .sec-title { font-size: 20px; margin: 0; letter-spacing: -0.02em; }
  .sec-title .ce { margin-right: 4px; }

  /* 대표(최신) 글 */
  .featured-wrap { margin-top: 40px; }
  .featured-wrap .sec-title { margin-bottom: 16px; }
  .featured {
    display: grid; grid-template-columns: 1.15fr 1fr; overflow: hidden; color: var(--text);
  }
  .featured:hover { border-color: var(--accent); text-decoration: none; }
  .f-thumb { aspect-ratio: 16 / 9; background: var(--bg-soft); display: grid; place-items: center; }
  .f-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .f-emoji { font-size: 52px; }
  .f-body { padding: 26px 28px; display: grid; align-content: center; gap: 10px; }
  .f-top { display: flex; align-items: center; gap: 8px; }
  .f-body .cat { font-size: 13px; font-weight: 700; color: var(--accent-ink); }
  .f-body h3 { margin: 2px 0; font-size: 26px; line-height: 1.35; letter-spacing: -0.02em; }
  .f-desc { margin: 0; color: var(--text-soft); font-size: 15.5px; line-height: 1.6; }
  .f-body .date { font-size: 13px; color: var(--text-mute); }

  /* 카테고리 섹션 */
  .cat-section { margin-top: 44px; }
  .cat-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16px; }
  .more { font-size: 14px; font-weight: 700; color: var(--accent); white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }

  @media (max-width: 720px) {
    .featured { grid-template-columns: 1fr; }
    .f-thumb { aspect-ratio: 16 / 9; }
    .f-body { padding: 20px; }
    .f-body h3 { font-size: 21px; }
  }
  @media (max-width: 480px) { .hero h1 { font-size: 27px; } }
</style>
