---
import { fmtDate, daysUntil } from "../lib/utils";

interface Props {
  status: "상시" | "진행중" | "마감임박" | "마감";
  deadline?: Date;
}
const { status, deadline } = Astro.props;

// 상시이면서 마감일 정보가 없으면 위젯 자체를 렌더링하지 않음
const show = !(status === "상시" && !deadline);

const d = daysUntil(deadline);
let ddayLabel = "";
let tone: "ok" | "warn" | "danger" | "mute" = "ok";

if (deadline) {
  if (d === null || d < 0) {
    ddayLabel = "마감";
    tone = "mute";
  } else if (d === 0) {
    ddayLabel = "D-DAY";
    tone = "danger";
  } else {
    ddayLabel = `D-${d}`;
    tone = d <= 7 ? "danger" : d <= 30 ? "warn" : "ok";
  }
}
---

{show && (
<div class={`deadline ${tone}`} role="note">
  <div class="left">
    <span class="status">{status}</span>
    {deadline && <span class="date">마감 {fmtDate(deadline)}</span>}
  </div>
  {deadline && <span class="dday">{ddayLabel}</span>}
</div>
)}

<style>
  .deadline {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 16px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--bg-soft);
    margin: 18px 0;
  }
  .left { display: flex; flex-direction: column; gap: 2px; }
  .status { font-weight: 700; font-size: 14px; }
  .date { font-size: 13px; color: var(--text-mute); }
  .dday { font-weight: 800; font-size: 18px; letter-spacing: 0.02em; }
  .deadline.ok .dday { color: var(--ok); }
  .deadline.warn { border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
  .deadline.warn .dday { color: var(--warn); }
  .deadline.danger { border-color: color-mix(in srgb, var(--danger) 45%, transparent); background: color-mix(in srgb, var(--danger) 7%, transparent); }
  .deadline.danger .dday { color: var(--danger); }
  .deadline.mute { opacity: 0.7; }
  .deadline.mute .dday { color: var(--text-mute); }
</style>
