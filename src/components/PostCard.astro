---
import { postUrl, fmtDate } from "../lib/utils";
import { CATEGORY_MAP } from "../site.config";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  id: string;
  category: string;
  title: string;
  description: string;
  publishDate: Date;
  status?: "상시" | "진행중" | "마감임박" | "마감";
  thumb?: string;
}
const { id, category, title, description, publishDate, status = "상시", thumb } = Astro.props;
const cat = CATEGORY_MAP[category];
---

<article class="post-card card">
  <a href={postUrl(category, id)} class="thumb-link" aria-hidden="true" tabindex="-1">
    {thumb ? (
      <img src={`/shots/${thumb}/thumb-wide.webp`} alt="" loading="lazy" width="640" height="360" />
    ) : (
      <div class="thumb-fallback">{cat?.emoji ?? "📄"}</div>
    )}
  </a>
  <div class="body">
    <div class="top">
      <span class="cat">{cat?.name ?? category}</span>
      <StatusBadge status={status} />
    </div>
    <h3><a href={postUrl(category, id)}>{title}</a></h3>
    <p class="desc">{description}</p>
    <time class="date">{fmtDate(publishDate)}</time>
  </div>
</article>

<style>
  .post-card { overflow: hidden; display: flex; flex-direction: column; }
  .thumb-link { display: block; aspect-ratio: 16 / 9; background: var(--bg-soft); }
  .thumb-link img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-fallback { width: 100%; height: 100%; display: grid; place-items: center; font-size: 40px; }
  .body { padding: 14px 16px 16px; display: grid; gap: 6px; }
  .top { display: flex; align-items: center; gap: 8px; }
  .cat { font-size: 12.5px; font-weight: 700; color: var(--accent-ink); }
  h3 { margin: 2px 0; font-size: 17.5px; line-height: 1.4; letter-spacing: -0.01em; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--accent); text-decoration: none; }
  .desc {
    margin: 0; font-size: 14.5px; color: var(--text-soft);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .date { font-size: 12.5px; color: var(--text-mute); }
</style>
